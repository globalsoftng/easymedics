-- Create tracking table if it doesn't exist
IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[SchemaUpdates]') AND type in (N'U'))
BEGIN
    CREATE TABLE dbo.SchemaUpdates (
        UpdateKey VARCHAR(100) PRIMARY KEY,
        AppliedOn DATETIME DEFAULT GETDATE()
    )
END

------------------------------------------------------------
-- Index: tblClinicals
IF NOT EXISTS (SELECT * FROM sys.indexes WHERE name = 'IX_tblClinicals_ClientID_TestID_date_reg')
BEGIN
    CREATE NONCLUSTERED INDEX IX_tblClinicals_ClientID_TestID_date_reg
    ON dbo.tblClinicals (ClientID, TestID, date_reg)
    INCLUDE (clinicalID, status, Amount, reportType, date_modified, _order_id, _orderdetail_id, date_reported)

    INSERT INTO dbo.SchemaUpdates (UpdateKey) VALUES ('IX_tblClinicals_ClientID_TestID_date_reg')
END

------------------------------------------------------------
-- Index: tblPayment
IF NOT EXISTS (SELECT * FROM sys.indexes WHERE name = 'IX_tblPayment_transID_date_added')
BEGIN
    CREATE NONCLUSTERED INDEX IX_tblPayment_transID_date_added
    ON dbo.tblPayment (transID, date_added)
    INCLUDE (totalAmt, status, ClinicalInfo, AmtToPay, Referrer, CorporateDoc)

    INSERT INTO dbo.SchemaUpdates (UpdateKey) VALUES ('IX_tblPayment_transID_date_added')
END
------------------------------------------------------------
-- Index: tblSetting
IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[tblSettings ]') AND type in (N'U'))
BEGIN
   CREATE TABLE tblSettings (
    Id INT PRIMARY KEY IDENTITY(1,1),
    Setting VARCHAR(50) NOT NULL,
    Value VARCHAR(50) NULL);
    INSERT INTO tblSettings (Setting, Value) VALUES ('should_send_email', '1');
    INSERT INTO tblSettings (Setting, Value) VALUES ('should_send_wa', '0');

    INSERT INTO dbo.SchemaUpdates (UpdateKey) VALUES ('create_settings_table')
END

------------------------------------------------------------
-- Index: tblClientsInfo
IF NOT EXISTS (SELECT * FROM sys.indexes WHERE name = 'IX_tblClientsInfo_ID')
BEGIN
    CREATE NONCLUSTERED INDEX IX_tblClientsInfo_ID
    ON dbo.tblClientsInfo (ID)
    INCLUDE (Name, lastname, dob, Sex, EmailAddress, EDD, LMP)

    INSERT INTO dbo.SchemaUpdates (UpdateKey) VALUES ('IX_tblClientsInfo_ID')
END

------------------------------------------------------------
-- Index: tblTestType
IF NOT EXISTS (SELECT * FROM sys.indexes WHERE name = 'IX_tblTestType_TestID_testCategoryID')
BEGIN
    CREATE NONCLUSTERED INDEX IX_tblTestType_TestID_testCategoryID
    ON dbo.tblTestType (TestID, testCategoryID)
    INCLUDE (TestDescription)

    INSERT INTO dbo.SchemaUpdates (UpdateKey) VALUES ('IX_tblTestType_TestID_testCategoryID')
END

------------------------------------------------------------
-- Index: testCategory
IF NOT EXISTS (SELECT * FROM sys.indexes WHERE name = 'IX_testCategory_testCategoryID')
BEGIN
    CREATE NONCLUSTERED INDEX IX_testCategory_testCategoryID
    ON dbo.testCategory (testCategoryID)
