IF COL_LENGTH('dbo.tblCoporateAccts', 'AccountType') IS NULL
BEGIN
    ALTER TABLE dbo.tblCoporateAccts ADD AccountType INT NOT NULL DEFAULT 2
    INSERT INTO dbo.SchemaUpdates (UpdateKey) VALUES ('tblCoporateAccts_AccountType_added')
